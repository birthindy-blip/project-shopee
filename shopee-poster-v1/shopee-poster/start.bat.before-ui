@echo off
chcp 65001 >nul
set PYTHONUTF8=1
set PYTHONIOENCODING=utf-8
cd /d "%~dp0"
set PY=python
where py >nul 2>nul
if not errorlevel 1 set PY=py
%PY% -c "import uiautomator2" >nul 2>nul
if errorlevel 1 (
  echo [setup] Installing uiautomator2 - first time only, please wait...
  %PY% -m pip install -r requirements.txt
  if errorlevel 1 (
    echo.
    echo [error] Install failed. Check that Python is installed and "Add python.exe to PATH" was ticked.
    pause
    exit /b 1
  )
)
%PY% shopee_poster.py %*
pause
